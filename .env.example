# --- Base de datos ---
# La URI se guarda LITERAL, con el placeholder <db_password> incluido.
# La contrasena se inyecta por separado y se URL-encodea en config/env.ts
DB_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/?appName=<app>
DB_PASSWORD=
# Base local: alfii_dev  |  Base de produccion: alfii
DB_NAME=alfii_dev

# --- Servidor ---
PORT=8100
NODE_ENV=development

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=30d

# --- Gemini ---
# IMPORTANTE: el proyecto de Google Cloud asociado a esta key DEBE tener
# facturacion habilitada. En capa gratuita Google usa los prompts para
# mejorar sus productos, lo que invalida la promesa de privacidad del producto.
GEMINI_API_KEY=
GEMINI_BILLING_CONFIRMED=true
GEMINI_MODEL_VISION=gemini-2.5-flash
GEMINI_MODEL_CHAT=gemini-2.5-flash
GEMINI_MODEL_ANALYSIS=gemini-3.6-flash

# --- Cadena de proveedores de modelo ---
# Orden de preferencia. Gemini primero por costo; el siguiente entra solo si el
# anterior falla o bloquea. El failover es invisible para el usuario porque la
# memoria del agente vive en Mongo, no en el proveedor.
# Proveedores validos: gemini, openai, deepseek
AI_PROVIDER_CHAIN=gemini,openai

# Cadenas por tarea (vacio = hereda la de arriba). Los proveedores no rinden
# igual en cada tarea: DeepSeek es el mas rapido conversando pero tardo 43s y
# necesito reparacion produciendo el JSON de los 6 bloques.
AI_CHAIN_CHAT=
AI_CHAIN_ANALYSIS=
AI_CHAIN_VISION=

# --- OpenAI (respaldo) ---
# OJO: una Admin key (sk-admin-) NO sirve para inferencia. Necesita sk-proj-.
# Los modelos gpt-5.5+ rechazan el parametro temperature: el provider lo omite
# solo para esa familia. Verifica con models.list que el id exista en tu cuenta;
# "gpt-5.6" a secas no existe, son variantes (terra / sol / luna).
OPENAI_API_KEY=
OPENAI_MODEL_VISION=gpt-5.6-terra
OPENAI_MODEL_CHAT=gpt-5.4-mini
OPENAI_MODEL_ANALYSIS=gpt-5.6-terra

# --- DeepSeek (opcional, SOLO TEXTO: no lee capturas) ---
# DEEPSEEK_THINKING=false es importante: con el razonamiento activo el modelo
# gasta el presupuesto de max_tokens pensando y devuelve respuestas VACIAS en
# las llamadas cortas (saludo 400 tokens, extractor de estado 700).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=false
DEEPSEEK_MODEL_CHAT=deepseek-v4-flash
DEEPSEEK_MODEL_ANALYSIS=deepseek-v4-pro

# --- Almacenamiento de capturas (Cloudinary) ---
# STORE_SCREENSHOTS cambia la promesa del producto: con true las capturas se
# conservan en el hilo de cada chica. La copia del Home y la capa legal DEBEN
# coincidir con este valor. Se sube en modo `authenticated`: sin URL publica,
# solo URLs firmadas de vida corta.
STORE_SCREENSHOTS=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=alfii
CLOUDINARY_SIGNED_URL_TTL_SECONDS=3600

# --- Correo transaccional (Resend) ---
# REGLA DURA: los correos NUNCA mencionan a las chicas. Solo cuenta, logros del
# usuario y contrasena. Un correo se reenvia, se ve en la pantalla de bloqueo y
# vive en un tercero: es el canal menos privado del producto.
# MAIL_ENABLED=false deja los correos en consola sin enviarlos (desarrollo).
RESEND_API_KEY=
MAIL_FROM=Alfii <team@alfii.ec>
MAIL_REPLY_TO=team@alfii.ec
MAIL_ENABLED=false

# --- Base de los enlaces que van en los correos ---
# Local:      http://localhost:5173
# Tunnel:     https://testing-storybrand-frontend.bakano.ec
# Produccion: https://alfii.ec
# Si esto apunta mal, el usuario que perdio su contrasena no puede volver a entrar.
APP_URL=http://localhost:5173

# --- Observabilidad (interno, nunca visible al usuario) ---
SLACK_ERROR_WEBHOOK=

# --- Legal ---
LEGAL_CONTACT_PRIVACY=privacidad@alfii.ec
LEGAL_CONTACT_LEGAL=legal@alfii.ec
LEGAL_OPERATOR=alfii.ec
