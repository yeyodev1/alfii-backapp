{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "memory": 1769,
      "maxDuration": 300
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [
    { "path": "/api/cron/reengagement", "schedule": "37 14 * * *" },
    { "path": "/api/cron/reengagement", "schedule": "13 18 * * *" },
    { "path": "/api/cron/reengagement", "schedule": "46 23 * * *" }
  ]
}
